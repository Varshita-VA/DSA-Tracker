class Solution {
    public int maxArea(int[] height) {
        //2 pointer
        int left=0;
        int right=height.length-1;
        int max=0;
        while(left<right){
            int width=right-left;
            int waterlevel=Math.min(height[left],height[right]);
            int area=width*waterlevel;
            max=Math.max(area,max);

            if(height[left]<height[right]){
                left++;
            }
            else{
                right--;
            }
        }
        return max;
    }
}