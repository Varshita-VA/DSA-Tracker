class Solution {
    public int maxLen(int[] arr) {
        // Your code goes here
        
        int maxlength=0;
        for(int i=0;i<arr.length;i++){
            int sum=0;
            for(int j=i;j<arr.length;j++){
                sum+=arr[j];
                if(sum==0){
                    int length=(j-i)+1;
                    maxlength=Math.max(maxlength,length);
                }
                

            }
        }
        return maxlength;
    }
}
